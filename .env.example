# Credenziali MySQL
DB_HOST=127.0.0.1 # Host Database
DB_NAME=NomeDatabase # Nome del database 
DB_USER=TuoUtente # Username MySQL
DB_PASSWORD=LaTuaPassword123 # Password MySQL 
DB_PORT=3306 # Porta MySQL

# Porta backend
BACKEND_PORT=3001

# Porta front-end
FRONTEND_PORT=8080

# Tempo refresh dati in minuti
POLL_INTERVAL_MINUTES=5

# Url dell'applicazione
PUBLIC_API_URL=http://example.com

# Credenziali Gluroo
GLUROO_API_SECRET_TOKEN=xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GLUROO_API_SECRET_HEADER=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GLUROO_BASE_URL=https://xxxx.ns.gluroo.com
